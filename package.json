{
  "name": "ktb4-17th-fe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:biome": "biome ci --indent-style=space --indent-width=2 .",
    "lint:html": "htmlhint \"**/*.html\"",
    "lint:css": "stylelint \"**/*.css\"",
    "typecheck": "node --check src/app.js",
    "build": "rm -rf dist && mkdir -p dist && cp -R src/. dist/"
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "htmlhint": "^1.8.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1"
  }
}
