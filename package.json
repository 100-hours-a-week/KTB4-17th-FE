{
  "name": "dating-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint:biome": "biome ci --indent-style=space --indent-width=2 src",
    "lint:html": "htmlhint index.html",
    "lint:css": "stylelint src/styles.css",
    "typecheck": "node --check src/api.js && node --check src/data.js"
  },
  "dependencies": {
    "galmuri": "^2.40.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "htmlhint": "^1.8.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "vite": "8.2.1"
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard"
    ]
  }
}
